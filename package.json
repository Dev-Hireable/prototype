{
  "name": "hireable-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:e2e": "playwright test -c playwright.config.ts --project desktop --project los-angeles --project mobile",
    "test": "npm run test:unit && npm run test:e2e",
    "test:perf": "playwright test -c playwright.config.ts --project perf",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "2.1.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "3.15.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "^4.21.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
